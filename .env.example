# Copy to .env and fill in. .env is git-ignored. On a host such as Vercel these are set in the
# project's settings instead, and there is no file.

# The database. This one is the local Postgres from "npm run db:up".
DATABASE_URL=postgres://stock:stock@127.0.0.1:54329/stock
# A hosted Postgres gives two addresses: the pooled one above for the server, and a direct one for
# the commands that change the tables. Optional: empty means DATABASE_URL.
# DATABASE_URL_UNPOOLED=

# The password the app sends with every request (16+ characters). The app's VITE_APP_SECRET.
APP_SECRET=

# Claude API key, for reading photos. Without it photos cannot be read.
CLAUDE_API_KEY=
# Optional. Defaults to claude-haiku-5-5.
# CLAUDE_MODEL=

# The Apps Script web app (URL ending in /exec). The server copies every saved change to the Sheet
# through it and keeps product photos in Google Drive. Leave empty to run without Google.
SHEET_GATEWAY_URL=
# SERVER_SECRET in the Apps Script's Script Properties: the key to the actions only the server may
# call. Needed with SHEET_GATEWAY_URL. It must not be the app's secret, which every phone holds.
# SHEET_GATEWAY_SECRET=

# Optional. Defaults: port 8791, any origin, Africa/Accra.
# PORT=8791
# ALLOWED_ORIGINS=https://queenscode-stock.vercel.app
# SHOP_TIME_ZONE=Africa/Accra
